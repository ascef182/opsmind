# ── Database ──────────────────────────────────────────────
# Dono das tabelas — só para `prisma migrate`/seed. Nunca usada pela API em
# runtime (essa role tem superuser, bypassa Row-Level Security).
DATABASE_URL=postgresql://opsmind:opsmind@localhost:5432/opsmind?schema=public
# Runtime da API — role restrita (sem BYPASSRLS), criada por
# infra/docker/init/02-app-role.sql. É essa que faz as policies de RLS valerem.
DATABASE_URL_APP=postgresql://opsmind_app:opsmind_app@localhost:5432/opsmind?schema=public

# ── Redis (BullMQ workers arrive in Fase 5; connection configured from day 1) ──
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-32-chars-minimum-please
JWT_REFRESH_SECRET=change-me-different-secret-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── API ───────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:3001

# ── Web ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Email (dev default: logs to console instead of sending) ──
EMAIL_PROVIDER=console
# Só usados quando EMAIL_PROVIDER=resend (convites de organização + envio
# real de outreach, plano pensando-como-empresa-com-agile-beaver.md).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=OpsMind <onboarding@resend.dev>
# Rastreio de resposta via webhook inbound do Resend — sem ela, o endpoint
# recusa processar qualquer evento (fail-closed).
# RESEND_WEBHOOK_SECRET=
# Lembrete de follow-up (worker) — dias sem resposta antes de notificar.
OUTREACH_FOLLOWUP_THRESHOLD_DAYS=3
OUTREACH_FOLLOWUP_SCAN_INTERVAL_MS=86400000
# Lembrete de reunião (worker) — minutos antes do horário agendado.
MEETING_REMINDER_MINUTES_BEFORE=60

# ── Assinatura eletrônica (Clicksign, foco PT-BR) ───────────
# Opcional: sem ela, POST .../deals/:dealId/request-signature falha com uma
# mensagem clara no primeiro uso. Conta grátis em sandbox.clicksign.com/signup,
# token em Settings > API.
# CLICKSIGN_API_TOKEN=
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
# Chave da conta Clicksign, usada pra validar que um webhook recebido é
# mesmo desta conta (a Clicksign não documenta assinatura HMAC de webhook).
# CLICKSIGN_ACCOUNT_KEY=

# ── AI (Fase 3 — chat com tool calling) ─────────────────────
# Opcional: sem ela, POST /organizations/:organizationId/ai/chat falha com
# uma mensagem clara no primeiro uso; o resto da API funciona normalmente.
# ANTHROPIC_API_KEY=
# Só necessário se ANTHROPIC_API_KEY for uma chave de ORGANIZAÇÃO (não
# escopada a um workspace) — encontre o workspace em
# console.anthropic.com > Settings > Workspaces. Sem isso, chaves de
# organização falham com "This API key is not scoped to a workspace".
# ANTHROPIC_WORKSPACE_ID=
# Modelo usado pelo assistente — default claude-opus-5 (produção). O script
# `pnpm --filter api eval` sobrescreve para claude-sonnet-5 automaticamente.
# ANTHROPIC_MODEL=claude-opus-5

# ── Documentos + RAG (Fase 4) ────────────────────────────────
# Opcional, mesmo espírito da ANTHROPIC_API_KEY: sem ela, upload de documento
# falha com mensagem clara no primeiro uso (é preciso gerar embeddings).
# ANTHROPIC_API_KEY não serve aqui — Anthropic não tem endpoint de embeddings.
# OPENAI_API_KEY=
# `local` (padrão) grava em disco, fora de qualquer pasta versionada — não
# precisa de credencial nenhuma. `gcs` é a opção de produção (PRD §16), ainda
# não implementada.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/uploads

# ── Leads (Apify + Explorium + Camoufox) ─────────────────────
# Todas opcionais, mesmo espírito da ANTHROPIC_API_KEY: sem elas, disparar um
# ScrapeJob da fonte correspondente falha com mensagem clara no primeiro uso;
# o resto da API (e as outras fontes de leads) funciona normalmente.
# Apify — actor de Google Maps (dados estruturados: telefone/rating/site/categoria).
# APIFY_API_TOKEN=
# Id do actor Apify — tem default (não é segredo), só sobrescreva pra apontar
# pra outra versão/fork do actor.
APIFY_GOOGLE_MAPS_ACTOR_ID=compass/google-maps-extractor
# Explorium — mesma API por trás das tools MCP "Vibe Prospecting" (busca +
# enrichment B2B com firmografia).
# EXPLORIUM_API_KEY=
# camofox-browser (https://github.com/jo-inc/camofox-browser) — navegador
# stealth self-hosted, cobertura ampla via macros (@google_search/etc.)
# quando não há API estruturada pra fonte desejada. O `docker compose`
# (infra/docker/docker-compose.yml) já sobe o serviço na porta 9377 por
# padrão — sem esta variável setada, toda tool que dependa dele (scan de
# oportunidades de mercado no Reddit, sourceType CAMOFOX_*) falha em
# silêncio (erro capturado só pelo Sentry, nunca visível na UI).
CAMOFOX_API_URL=http://localhost:9377
# Só necessário contra uma instância hospedada/protegida do camofox-browser
# — o container local do docker-compose não exige.
# CAMOFOX_ACCESS_KEY=
# Descoberta de contato/redes (Task 9) — Actors da Apify (caminho primário,
# reaproveita APIFY_API_TOKEN acima), com fallback pro Camoufox já
# configurado acima quando indisponível/sem resultado. Ambos têm default
# (não são segredo), mesmo espírito de APIFY_GOOGLE_MAPS_ACTOR_ID.
APIFY_CONTACT_ENRICHMENT_ACTOR_ID=vdrmota/contact-info-scraper
APIFY_INSTAGRAM_PROFILE_ACTOR_ID=apify/instagram-profile-scraper
# Intervalo (ms) do scan automático de `ProspectingTarget`s ativos, que
# enfileira `ScrapeJob`s sozinho (apps/worker/src/prospecting-scan.ts).
# Default: 1 dia (86400000ms) — um `ScrapeJob` automático tem custo real de
# orçamento, então não faz sentido rodar com a mesma frequência do scan de
# automations (60s).
# PROSPECTING_SCAN_INTERVAL_MS=86400000
# Intervalo (ms) do scan automático de `RedditWatchTopic`s ativos, que busca
# posts candidatos via Camoufox e enfileira jobs de clustering
# (apps/worker/src/reddit-mining-scan.ts). Default: 1 dia (86400000ms).
# REDDIT_MINING_SCAN_INTERVAL_MS=86400000
