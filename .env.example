# ── Database ──────────────────────────────────────────────
# Dono das tabelas — só para `prisma migrate`/seed. Nunca usada pela API em
# runtime (essa role tem superuser, bypassa Row-Level Security).
DATABASE_URL=postgresql://opsmind:opsmind@localhost:5432/opsmind?schema=public
# Runtime da API — role restrita (sem BYPASSRLS), criada por
# infra/docker/init/02-app-role.sql. É essa que faz as policies de RLS valerem.
DATABASE_URL_APP=postgresql://opsmind_app:opsmind_app@localhost:5432/opsmind?schema=public

# ── Redis (BullMQ workers arrive in Fase 5; connection configured from day 1) ──
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-32-chars-minimum-please
JWT_REFRESH_SECRET=change-me-different-secret-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── API ───────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:3001

# ── Web ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Email (dev default: logs to console instead of sending) ──
EMAIL_PROVIDER=console

# ── AI (Fase 3 — chat com tool calling) ─────────────────────
# Opcional: sem ela, POST /organizations/:organizationId/ai/chat falha com
# uma mensagem clara no primeiro uso; o resto da API funciona normalmente.
# ANTHROPIC_API_KEY=
# Modelo usado pelo assistente — default claude-opus-5 (produção). O script
# `pnpm --filter api eval` sobrescreve para claude-haiku-4-5 automaticamente.
# ANTHROPIC_MODEL=claude-opus-5

# ── Documentos + RAG (Fase 4) ────────────────────────────────
# Opcional, mesmo espírito da ANTHROPIC_API_KEY: sem ela, upload de documento
# falha com mensagem clara no primeiro uso (é preciso gerar embeddings).
# ANTHROPIC_API_KEY não serve aqui — Anthropic não tem endpoint de embeddings.
# OPENAI_API_KEY=
# `local` (padrão) grava em disco, fora de qualquer pasta versionada — não
# precisa de credencial nenhuma. `gcs` é a opção de produção (PRD §16), ainda
# não implementada.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/uploads
