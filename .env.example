# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://opsmind:opsmind@localhost:5432/opsmind?schema=public

# ── Redis (BullMQ workers arrive in Fase 5; connection configured from day 1) ──
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-32-chars-minimum-please
JWT_REFRESH_SECRET=change-me-different-secret-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── API ───────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:3001

# ── Email (dev default: logs to console instead of sending) ──
EMAIL_PROVIDER=console

# ── AI (wired starting Fase 3 — placeholders so env schema is stable) ──
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
