// OpsMind — schema Prisma
//
// Fase 1 (Foundation): cobre o critério de aceitação do PRD §17 — "um usuário
// consegue criar uma organização, convidar outro usuário com um papel
// específico, e uma ação sensível gera um registro de auditoria."
//
// Fase 2 (Core Product): Customer/Task/ActivityLog/Notification — critério de
// aceitação "criar um cliente, registrar atividades nele, criar e concluir
// uma tarefa, e ver tudo refletido na timeline e no dashboard". Correções já
// decididas na síntese de planejamento (sprint-1-2-plan.md §2) aplicadas
// desde a criação destas tabelas:
//   - `deleted_at` em Customer (soft-delete, PRD §8) — item 2.
//   - `actor_type`/`actor_id` (em vez de um campo "ator livre") em Task e
//     ActivityLog, replicando o padrão já correto de AuditLog — item 7.
//
// `Document`, `DocumentChunk`, `Automation*`, `AIRequest` entram nas fases
// correspondentes (PRD §17), com `organization_id` denormalizado obrigatório
// desde a criação (item 1 da mesma síntese).
//
// Referência de design (Fase 1): docs/planning/reviews/code-architect-review.md
// e docs/planning/reviews/database-reviewer-review.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditActorType {
  USER
  AI
  SYSTEM
  AUTOMATION
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum AIRequestStatus {
  SUCCESS
  ERROR
  BUDGET_EXCEEDED
}

// ── Core tenancy ─────────────────────────────────────────────────────────

model Organization {
  id     String @id @default(uuid())
  name   String
  slug   String @unique
  plan   String @default("free")

  aiMonthlyBudget   Decimal? @map("ai_monthly_budget") @db.Decimal(10, 2)
  // Regra de negócio (PRD §8): "cliente inativo há mais de N dias, configurável
  // por organização, padrão 14" — sem este campo não há onde configurar o N.
  inactiveAfterDays Int      @default(14) @map("inactive_after_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  customers     Customer[]
  tasks         Task[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  aiRequests    AIRequest[]

  @@map("organizations")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships             Membership[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         Invitation[]              @relation("InvitedBy")
  ownedCustomers          Customer[]                @relation("CustomerOwner")
  assignedTasks           Task[]                    @relation("TaskAssignee")
  notifications           Notification[]
  aiRequests              AIRequest[]

  @@map("users")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ── Auth support ─────────────────────────────────────────────────────────
// Nenhuma destas três entidades está listada no PRD §9 ("entidades principais"),
// mas são pré-requisitos diretos do escopo funcional da própria Fase 1 (Auth com
// refresh, verificação de e-mail, convite de membros). Ver
// docs/planning/sprint-1-2-plan.md §2, itens 3-4.

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  // Nunca o token bruto — só o hash (SHA-256). O valor bruto existe apenas no
  // cookie httpOnly emitido ao cliente.
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  // Rotação: ao usar um refresh token, um novo é emitido e este campo aponta
  // para ele. Reapresentar um token já "substituído" é sinal de roubo — revoga
  // a família inteira (security-reviewer, achado A2/M2).
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdByIp       String?   @map("created_by_ip")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ── Invitations (org membership onboarding) ────────────────────────────────
// Regra de negócio (PRD §8): convites expiram em 7 dias. `Membership` pressupõe
// um `userId` existente, mas o convite acontece antes de a pessoa ter conta —
// por isso é uma entidade própria, promovida a Membership só na aceitação.

model Invitation {
  id              String           @id @default(uuid())
  organizationId  String           @map("organization_id")
  email           String
  role            Role
  tokenHash       String           @unique @map("token_hash")
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @map("invited_by_user_id")
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ── Audit (append-only, imutável — PRD §8) ──────────────────────────────────

model AuditLog {
  id             String         @id @default(uuid())
  // Nullable: alguns eventos acontecem antes de qualquer organização existir
  // (ex.: "user.registered"). Desvio intencional do PRD §9, documentado em
  // docs/planning/reviews/code-architect-review.md, Decisão #8.
  organizationId String?        @map("organization_id")
  actorType      AuditActorType @map("actor_type")
  // Não é FK: o ator pode ser AI/system/automation, não só um User.
  actorId        String?        @map("actor_id")
  action         String
  resource       String
  metadata       Json?
  ipAddress      String?        @map("ip_address")
  userAgent      String?        @map("user_agent")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ── Core Product (Fase 2 — CRM, tasks, timeline, notificações) ─────────────

model Customer {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  name           String
  company        String?
  email          String?
  phone          String?
  status         CustomerStatus @default(LEAD)
  // Array nativo por simplicidade no MVP (PRD §9 já descreve `tags[]`);
  // normalizar em Tag/CustomerTag é uma otimização de médio prazo, não
  // bloqueante (database-reviewer-review.md §4.3). Sem índice GIN por ora —
  // volume de dados de portfólio não justifica o preview feature extra.
  tags           String[]       @default([])
  ownerUserId    String?        @map("owner_user_id")
  // Regra de negócio (PRD §8): cliente inativo = sem atividade há N dias.
  // Atualizado pelo service a cada ActivityLog novo — nunca calculado on the
  // fly a partir do histórico completo (a query de inatividade, caso de uso
  // central do produto, precisa ser um filtro indexado direto neste campo).
  lastActivityAt DateTime?      @map("last_activity_at")
  // Soft-delete com trilha de auditoria (PRD §8) — toda query de listagem
  // filtra `deletedAt: null` explicitamente no service, nunca por convenção.
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?         @relation("CustomerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  tasks        Task[]
  activityLogs ActivityLog[]

  @@index([organizationId, status])
  @@index([organizationId, lastActivityAt])
  @@index([ownerUserId])
  @@map("customers")
}

model Task {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  customerId     String?    @map("customer_id")
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  assigneeId     String?    @map("assignee_id")
  dueDate        DateTime?  @map("due_date")
  completedAt    DateTime?  @map("completed_at")
  // Ator polimórfico (database-reviewer-review.md §4.2): substitui o
  // `created_by (user|ai|automation)` do PRD §9 por actor_type/actor_id,
  // replicando o padrão já correto de AuditLog — sem FK rígida, o ator pode
  // ser AI/automation, não só um User.
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, dueDate])
  @@index([customerId])
  @@map("tasks")
}

// Timeline do cliente (PRD §9: "ActivityLog"). Append-only, como AuditLog —
// nunca editado/apagado pela aplicação.
model ActivityLog {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  customerId     String         @map("customer_id")
  // String livre (ex.: "note.added", "task.completed"), no mesmo espírito de
  // `AuditLog.action` — extensível sem migration a cada novo tipo de evento.
  type           String
  payload        Json?
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, createdAt])
  @@map("activity_logs")
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  type           String
  payload        Json?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

// ── AI Assistant (Fase 3 — chat com tool calling) ───────────────────────────
// Observabilidade de IA (PRD §13): todo request de IA grava tokens, custo
// estimado, latência e as tools chamadas — alimenta o painel de analytics
// (Fase 7) e é a base dos evals. Campos além do esboço mínimo do PRD §9
// (session_id, status, error_message, tool_calls normalizado numa tabela
// própria) já decididos na síntese de planejamento da Fase 1
// (sprint-1-2-plan.md §2, item 8) para entrar aqui, na Fase 3, e não como
// retrofit na Fase 7.

model AIRequest {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  userId         String          @map("user_id")
  // Agrupa múltiplas mensagens da mesma conversa — nulo no MVP (cada chat()
  // é uma troca isolada); passa a ser preenchido quando a UI de chat
  // (apps/web) mantiver uma sessão entre mensagens.
  sessionId      String?         @map("session_id")
  model          String
  inputTokens    Int             @default(0) @map("input_tokens")
  outputTokens   Int             @default(0) @map("output_tokens")
  latencyMs      Int             @map("latency_ms")
  // numeric, nunca float (síntese de planejamento §2, item 9) — erro de
  // arredondamento em custo estimado composta ao longo de milhares de
  // requests.
  estimatedCost  Decimal         @default(0) @map("estimated_cost") @db.Decimal(10, 4)
  status         AIRequestStatus
  errorMessage   String?         @map("error_message")
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls    AIRequestToolCall[]

  @@index([organizationId, createdAt])
  @@map("ai_requests")
}

// Tabela própria em vez de `tool_calls: Json[]` no AIRequest (síntese de
// planejamento §2, item 8) — sem isso não dá para consultar "quantas vezes
// a tool X foi chamada" ou "qual tool falha mais" sem parsear JSON solto.
model AIRequestToolCall {
  id          String   @id @default(uuid())
  aiRequestId String   @map("ai_request_id")
  toolName    String   @map("tool_name")
  input       Json
  output      Json?
  isError     Boolean  @default(false) @map("is_error")
  createdAt   DateTime @default(now()) @map("created_at")

  aiRequest AIRequest @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)

  @@index([aiRequestId])
  @@map("ai_request_tool_calls")
}
